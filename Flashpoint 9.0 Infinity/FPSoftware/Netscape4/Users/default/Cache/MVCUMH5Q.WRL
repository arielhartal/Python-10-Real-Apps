DEF OriInterpolator OrientationInterpolator{
  key[ 0, 0.25, 0.5, 0.75, 1 ]
    keyValue[
    1 0 0 -0.75,
    1 0 0  0,
    1 0 0  0.75,
    1 0 0  0,
    1 0 0 -0.75
  ]
    }

      
DEF MyTimer TimeSensor{
  cycleInterval 6
    loop TRUE
    }

ROUTE MyTimer.fraction_changed TO OriInterpolator.set_fraction
ROUTE OriInterpolator.value_changed TO Armright.set_rotation


