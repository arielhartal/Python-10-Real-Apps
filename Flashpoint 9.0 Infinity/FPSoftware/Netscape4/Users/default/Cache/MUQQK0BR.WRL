#VRML V2.0 utf8
Background{
 skyColor 1 1 1
}
Transform{
 translation 0 -0.2 0
 children[
Shape{
 appearance Appearance{
  material Material{
   diffuseColor 1 1 0
  }
 }
 geometry Cylinder{
  radius 0.05
  height 0.4
 }
}
]
}
DEF Pro Transform{
 translation 0 0 0
 children[
  Shape{
   appearance Appearance{
    material Material{
     diffuseColor 1 1 0
    }
   }
   geometry Box{size 0.6 0.1 0.1}
  }
 ]
}
DEF OriInterpolator OrientationInterpolator{
 key[0, 0.125, 0.25, 0.375, 0.5, 0.625, 0.75, 0.875, 1]
 keyValue[
  0 1 0 0,
  0 1 0 0.785,
  0 1 0 1.57,
  0 1 0 2.355,
  0 1 0 3.14,
  0 1 0 -2.355,
  0 1 0 -1.57,
  0 1 0 -0.785,
  0 1 0 0
 ]
}
DEF MyTimer TimeSensor{
 cycleInterval 1
 loop TRUE
}
ROUTE MyTimer.fraction_changed TO OriInterpolator.set_fraction
ROUTE OriInterpolator.value_changed TO Pro.set_rotation