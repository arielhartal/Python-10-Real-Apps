#VRML V2.0 utf8
Background{
	skyColor 1 1 1
}
DEF Doutai Transform{
	translation 0 0 0
		children[

Inline{
   url "1.30.doutai.wrl"
   }
  ]
}

DEF Ketu Transform{
	translation 0 -0.29 0
		children[
Inline{
   url "1.30.ketu.wrl"
  }
 ]
}
 
DEF Head Transform{
	translation 0 0.55 0 
		children[
Inline{
    url "1.30.head.wrl"
    }
  ]
}

DEF Armright Transform{
	translation -0.32 0.5 0
		children[
			Inline{
      				url "1.30.arm.ue.wrl"
				}
	Transform{
		translation 0 -0.52 0
		children[
			Inline{
      				url "1.30.arm.sita.wrl"
				}
	Transform{
		translation 0 -0.13 0
		children[
			Inline{
      				url "1.30.kobusi.wrl"
				}
			]
		}
	]
    }
  ]
}

