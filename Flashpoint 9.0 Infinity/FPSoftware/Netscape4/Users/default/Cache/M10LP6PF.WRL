DEF MyTimer TimeSensor{
cycleInterval 8
loop TRUE
}

ROUTE MyTimer.fraction_changed TO Asi3Interpolator.set_fraction
ROUTE MyTimer.fraction_changed TO Asi4Interpolator.set_fraction
ROUTE Asi3Interpolator.value_changed TO Asi3.set_rotation
ROUTE Asi4Interpolator.value_changed TO Asi4.set_rotation

ROUTE MyTimer.fraction_changed TO AsiInterpolator.set_fraction
ROUTE MyTimer.fraction_changed TO Asi2Interpolator.set_fraction
ROUTE AsiInterpolator.value_changed TO Asi.set_rotation
ROUTE Asi2Interpolator.value_changed TO Asi2.set_rotation

ROUTE MyTimer.fraction_changed TO UdeInterpolator.set_fraction
ROUTE MyTimer.fraction_changed TO Ude2Interpolator.set_fraction
ROUTE UdeInterpolator.value_changed TO Ude.set_rotation
ROUTE Ude2Interpolator.value_changed TO Ude2.set_rotation

ROUTE MyTimer.fraction_changed TO Ude3Interpolator.set_fraction
ROUTE MyTimer.fraction_changed TO Ude4Interpolator.set_fraction
ROUTE Ude3Interpolator.value_changed TO Ude3.set_rotation
ROUTE Ude4Interpolator.value_changed TO Ude4.set_rotation

