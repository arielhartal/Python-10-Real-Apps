  }
  

  
  DEF TS TimeSensor {
    stopTime -1
    loop TRUE
    cycleInterval 40.0
  }
  DEF OI OrientationInterpolator {
    key [ 0 .5 1 ]
    keyValue [ 0 1 0 0, 0 1 0 3.14, 0 1 0 6.27 ]
  }
]}
ROUTE TS.fraction_changed TO OI.set_fraction
ROUTE OI.value_changed TO T.rotation

DEF Outside Viewpoint {
	description "Outside"
	position 1000.0000 1000.0000 1000.0000
	orientation -0.9000 0.9000 0.2000 1.0000
	fieldOfView 0.8000
}
  DEF Sol Viewpoint {
	description "View From Our Sun"
	position  0      0      0
	orientation 0.0000 10.0000 0.0000 1.5700
	fieldOfView 1.8000
  }