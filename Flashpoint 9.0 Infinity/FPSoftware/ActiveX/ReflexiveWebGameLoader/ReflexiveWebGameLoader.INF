;INF file for ReflexiveWebGameLoader.cab
;DestDir can be 10 for Windows directory, 11 for Windows\System(32) directory, or left blank for the Occache directory.

[version]
signature="$CHICAGO$"
AdvancedINF=2.0

[DefaultInstall]
CopyFiles=install.files
RegisterOCXs=RegisterFiles
AddReg=AddToRegistry

[RInstallApplicationFiles]
CopyFiles=install.files
RegisterOCXs=RegisterFiles
AddReg=AddToRegistry
[DestinationDirs]
install.files=11

[SourceDisksNames]
1=%DiskName%,ReflexiveWebGameLoader.cab,1

[Add.Code]
ReflexiveWebGameLoader.dll=ReflexiveWebGameLoader.dll

[install.files]
ReflexiveWebGameLoader.dll=ReflexiveWebGameLoader.dll

[SourceDisksFiles]
ReflexiveWebGameLoader.dll=1

[ReflexiveWebGameLoader.dll]
file-win32-x86=thiscab
RegisterServer=yes
clsid={3FE16C08-D6A7-4133-84FC-D5BFB4F7D886}
DestDir=
FileVersion=1,0,0,15

[Setup Hooks]
AddToRegHook=AddToRegHook

[AddToRegHook]
InfSection=DefaultInstall2

[DefaultInstall2]
AddReg=AddToRegistry

[AddToRegistry]
HKLM,"SOFTWARE\Classes\CLSID\{3FE16C08-D6A7-4133-84FC-D5BFB4F7D886}\Implemented Categories\{7DD95802-9882-11CF-9FA9-00AA006C42C4}"
HKLM,"SOFTWARE\Classes\CLSID\{3FE16C08-D6A7-4133-84FC-D5BFB4F7D886}\Implemented Categories\{7DD95801-9882-11CF-9FA9-00AA006C42C4}"
HKCR,"Licenses",,,"Licensing: Copying the keys may be a violation of established copyrights."

[RegisterFiles]
%11%\ReflexiveWebGameLoader.dll
