		DEF XForm Transform { 
				translation 17 4 -20 
				children [
                                Shape {	
				 appearance Appearance {
               			 material Material { 
             		         diffuseColor 1 0 0 
              				  }
          			  }
		    	       geometry Box {} },

                                DEF Clicker TouchSensor {}
                                DEF TimeSource TimeSensor { cycleInterval 3.0 loop TRUE }
                                DEF Animation OrientationInterpolator {
                                        key     [0,     .33,    .66,    1.0]
                                        keyValue[0 1 0 0, 0 1 0 2.1, 0 1 0 4.2, 0 1 0 0]
                                        }
				DEF AnimPos PositionInterpolator {
					key	[0 .5 1 ]
					keyValue[17 4 -20, 17 1 -20 ,17 4 -20]
