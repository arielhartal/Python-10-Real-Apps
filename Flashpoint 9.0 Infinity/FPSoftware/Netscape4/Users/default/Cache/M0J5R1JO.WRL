      					 side    TRUE
     						 top     TRUE
								} }
		
                                DEF TimeSource1 TimeSensor { cycleInterval 3.0 
							      startTime 0
							      loop TRUE
							      stopTime -1 }
                                DEF Animation1 
					PositionInterpolator {
                                        key     [0,     .33,   .66,     1.0]
                                        keyValue[10 2 -16 , 18 4 -10 ,14 6 -16 10 2 -16 ]
                                        }
			]
				 }
				
DEF THEO Transform {
                    translation 12 2 -10
        	    children [
			      Shape { 
				 geometry Sphere {radius 1.5}
				 appearance Appearance {material Material {diffuseColor 1 1 0} }
			      }
                    
 		              DEF THEOTIME TimeSensor { cycleInterval 3 
							loop TRUE 
							enabled TRUE 
							startTime 0
							stopTime -3}
		              DEF P  PositionInterpolator { 
		 			key [0, .5 ,1]
					keyValue [12 2 -10, 15 3 -7, 13 1 -12]
		    }
		    ]
}
				 ]
                                  ROUTE Clicker.touchTime TO TimeSource.startTime
                                  ROUTE TimeSource.fraction_changed TO Animation.set_fraction
                                  ROUTE Animation.value_changed TO XForm.rotation
				  ROUTE TimeSource.fraction_changed TO AnimPos.set_fraction
				  ROUTE AnimPos.value_changed TO XForm.translation

		#		  ROUTE Clicker1.touchTime TO TimeSource1.startTime
                                  ROUTE TimeSource1.fraction_changed TO Animation1.set_fraction
                                  ROUTE Animation1.value_changed TO XForm1.translation	
		#		  ROUTE Clicker2.touchTime TO TimeSource2.startTime
                #               ROUTE TimeSource2.fraction_changed TO Animation2.set_fraction
                #               ROUTE Animation2.value_changed TO Alekos.translation

		ROUTE THEOTIME.fraction_changed TO P.set_fraction
		ROUTE P.value_changed TO THEO.set_translation
					
				}



